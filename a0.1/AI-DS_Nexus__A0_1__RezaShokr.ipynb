    def __init__(self):
        self.p = Point(0, 0)
        self.q = Point(0, 0)

    def move_points(self, px, py, qx, qy):
        self.p.x, self.p.y = px, py
        self.q.x, self.q.y = qx, qy

    def distance(self):
        return self.p.distance_to(self.q)

